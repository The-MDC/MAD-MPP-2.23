# MAD Gambit AI Backend — Environment Variables
# Copy to .env for local dev. Never commit real values.

# ── Google Cloud ───────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# PLACEHOLDER — required before this service can call Gemini for real.
# Get one at https://aistudio.google.com/apikey (Google AI Studio),
# or leave empty and use Vertex AI application-default credentials
# instead (recommended for Cloud Run deployment — no key in env at all).
GOOGLE_API_KEY=

# ── Model selection ──────────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
GEMMA_MODEL=gemma-2-9b-it

# PLACEHOLDER — self-hosted Gemma endpoint. Leave empty during local
# dev; background_ai.py falls back to Gemini until this is set.
# Two real paths to fill this in:
#   1. Vertex AI Model Garden deployment (production path)
#   2. Local Ollama container running Gemma (fast to stand up for dev —
#      `ollama run gemma2:9b` then point this at http://ollama:11434)
GEMMA_ENDPOINT_URL=

# ── Database — Cloud SQL Postgres ──────────────────────────────────
# Local dev uses the docker-compose Postgres container (matches this
# default exactly). PLACEHOLDER for prod: real Cloud SQL connection string.
DATABASE_URL=postgresql://madgambit:madgambit@postgres:5432/madgambit

# ── App ─────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=30
