{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|feat/*) exit 1;; *) exit 0;; esac"
}