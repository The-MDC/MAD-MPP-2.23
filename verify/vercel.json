{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|feat/*|claude/*|vercel-agent/*) exit 1;; *) exit 0;; esac",
  "crons": [
    { "path": "/api/v1/cron/rollup", "schedule": "0 0 * * *" },
    { "path": "/api/v1/perps/roll", "schedule": "0 0 * * *" },
    { "path": "/api/v1/registrar/lapse", "schedule": "30 0 * * *" },
    { "path": "/api/v1/cron/insights", "schedule": "15 1 * * *" },
    { "path": "/api/v1/cron/weekly-report", "schedule": "0 13 * * 1" },
    { "path": "/api/v1/cron/memory", "schedule": "45 2 * * *" },
    { "path": "/api/v1/cron/memory-weekly", "schedule": "30 3 * * 1" },
    { "path": "/api/v1/cron/daily-log", "schedule": "20 0 * * *" }
  ]
}
