# MAD Gambit — Environment Variables
# Copy to .env.local for development. Never commit .env with real values.
#
# On Vercel these live in Project → Settings → Environment Variables (per
# Production / Preview / Development). Anything a browser must read is prefixed
# NEXT_PUBLIC_ (inlined at build time — never put secrets behind that prefix).

# ── Google Cloud Run ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── AI Studio / Gemini API (MADHAT'r persona + Z-Liar AI) ────────────
# NOTE: the code reads GOOGLE_API_KEY (concierge/chat + satire-engine routes),
# not GEMINI_API_KEY. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
# Model: gemini-flash-latest for concierge + satire engine
# Persona: see AGENTS.md for MADHAT'r system instructions

# ── Blockchain / Arbitrum (Nova launch · One vaults/token) ─────────────────────────────────────────
EVM_RPC_URL=https://arb1.arbitrum.io/rpc
EVM_RPC_URL_NOVA=https://nova.arbitrum.io/rpc
# Token: 0xb61ae7727579e3781ca0ec4902b6ba21d335fd18

# ── Contract addresses (front/back SYNC — read by lib/contracts.ts) ────
# These are NEXT_PUBLIC_ so the client and the API routes resolve the SAME
# addresses (no drift between what the UI shows and what the server calls).
# $MADx is live on Arbitrum One; the others are placeholders until deployed.
NEXT_PUBLIC_MADX_ADDRESS=0xb61ae7727579e3781ca0ec4902b6ba21d335fd18
NEXT_PUBLIC_STAKING_ADDRESS=
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# ── App config (front/back SYNC) ──────────────────────────────────────
# Canonical app URL: client fetch base, share links, SIWE domain binding.
NEXT_PUBLIC_APP_URL=https://mad-mpp-223-madgambit.vercel.app
# Active chain the UI + server agree on: 42161 = Arbitrum One, 42170 = Nova.
NEXT_PUBLIC_CHAIN_ID=42161

# ── Alchemy (AA-SDK + NFT reads) ──────────────────────────────────────
ALCHEMY_API_KEY=your-alchemy-key-here

# ── Chainlink VRF (pack randomness + oracle resolution) ───────────────
CHAINLINK_VRF_KEY=your-chainlink-key-here

# ── News API (Sentinel grounding) ─────────────────────────────────────
NEWS_API_KEY=your-newsapi-key-here

# ── GDELT ingest tuning (read by lib/gdelt-ingest.ts) ─────────────────
# Optional override of the house scandal/celebrity query. Falls back to the
# built-in DEFAULT_QUERY when unset.
GDELT_QUERY=

# ── Cron protection (read by api/v1/cron/rollup) ──────────────────────
# Shared secret so scheduled jobs (rollup, GDELT ingest) and manual triggers are
# authorized consistently. Set the same value in the Vercel Cron / caller header.
CRON_SECRET=your-cron-shared-secret-here

# ── Auth — SIWE session signing (REQUIRED in prod) ────────────────────
# HMAC key for signed session cookies (lib/session.ts). Without it, sign-in
# still verifies the signature but issues NO session cookie (fails closed).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-64-hex-char-session-secret-here

# The durable SIWE nonce store uses DATABASE_URL below (Neon). Run once:
#   CREATE TABLE IF NOT EXISTS siwe_nonces (nonce TEXT PRIMARY KEY,
#     issued_at TIMESTAMPTZ NOT NULL DEFAULT now());

# ── Database (Postgres — e.g. Cloud SQL / Neon) ──────────────────────
# Optional. The API routes degrade to in-memory/fallback data when unset.
DATABASE_URL=postgresql://user:password@host:5432/madgambit

# ── AI Studio Card Art CDN ────────────────────────────────────────────
# Drop 900+ AI-Studio generated cards at:
# /public/cards/{canonicalFactionId}/{serial}.webp
# Example: /public/cards/mad-council/0004.webp
# canonicalFactionId mapping: see docs/CARD_CANONICAL_REFERENCE.md
CARD_ART_CDN=https://your-cdn.com/cards
# Or serve locally: /cards/{canonicalFactionId}/{serial}.webp
